CompileFlags:
  Add:
    - "-Iinclude"
    - "-Isrc"
    - "-Ibuild/_deps/asio-src/asio/include"
    - "-Ibuild/_deps/websocketpp-src"
    - "-std=c++20"
    - "-DASIO_STANDALONE"
    - "-D_WEBSOCKETPP_CPP11_STRICT_"
    - "-D_WIN32_WINNT=0x0601"
    - "-DWIN32_LEAN_AND_MEAN"
    - "-DNOMINMAX"
    - "-DWIN32"
    - "-D_WINDOWS"

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
